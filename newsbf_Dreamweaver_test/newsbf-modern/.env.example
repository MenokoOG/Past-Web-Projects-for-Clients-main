# All providers below have a keyless free tier — the app runs with NO configuration.
# Supply keys only to raise rate limits or add providers.

# The Guardian Open Platform. Defaults to the public "test" key.
# Register for your own at https://open-platform.theguardian.com/access/
VITE_GUARDIAN_API_KEY=test

# GNews.io — optional. Free tier: 100 requests/day. https://gnews.io/
VITE_GNEWS_API_KEY=

# NewsAPI.org — optional, localhost-only on the free plan (CORS). https://newsapi.org/
VITE_NEWSAPI_KEY=
